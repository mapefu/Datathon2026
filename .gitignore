# Data (no subir datasets al repo)
data/raw/*
data/processed/*
!data/**/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Modelos y artefactos pesados
models/
*.pkl
*.joblib
*.pt
*.h5
*.ckpt

# Sistema / IDE
.DS_Store
.vscode/
.idea/

# Zips de entrega generados (se regeneran con scripts/make_submission.py)
submissions/*.zip

# Modelos del Mode Difícil (se regeneran con: python scripts/hard.py train --all)
submission_dificil/modelos_dificil.json

# DataDificil: pliegues y zips de experimentos (se regeneran con 02_train.py / 04_package_verify.py).
# Solo se versionan los pliegues default/d8/r150 (históricos) y hubcp (el de la entrega final).
DataDificil/data/processed/folds/*
!DataDificil/data/processed/folds/default/
!DataDificil/data/processed/folds/d8/
!DataDificil/data/processed/folds/r150/
!DataDificil/data/processed/folds/hubcp/
DataDificil/dist/*.zip
DataDificil/experimentos/**/bundle.npz
